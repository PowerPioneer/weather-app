# Environment Configuration for Flask App
# Copy this file to .env on your server and customize
# Leave as-is on development machines for auto-detection

# Application Environment
# Options: development, production
# If not set, auto-detects based on hostname (localhost = development)
FLASK_ENV=production

# Debug Mode
# Options: 0 (disabled), 1 (enabled)
# If not set, auto-detects from FLASK_ENV (development = debug on)
FLASK_DEBUG=0

# Flask Secret Key (required for production)
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
# Or add to keys/config.py as FLASK_SECRET_KEY
FLASK_SECRET_KEY=your-secret-key-here

# CDS API Credentials (only needed for data download scripts)
# Get from: https://cds.climate.copernicus.eu/how-to-api
# Can also be set in keys/config.py
CDS_API_KEY=your-cds-api-key

# Weather API Key (optional, for future features)
WEATHER_API_KEY=your-weather-api-key-here

# Redis Configuration (for caching)
# Set REDIS_ENABLED=0 to disable Redis caching (uses in-memory fallback)
# Auto-enabled in production, optional in development
REDIS_ENABLED=1

# Redis connection details (defaults to localhost:6379)
# REDIS_HOST=localhost
# REDIS_PORT=6379
# REDIS_DB=0
# REDIS_PASSWORD=

# Or use full Redis URL
# REDIS_URL=redis://localhost:6379/0
# For password: redis://:password@localhost:6379/0
